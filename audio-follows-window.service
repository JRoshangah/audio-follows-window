[Unit]
Description=Move app audio to the display its window is on
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStartPre=/usr/bin/amixer -c 0 sset IEC958,0 on
ExecStart=%h/.local/bin/audio-follows-window --watch
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
